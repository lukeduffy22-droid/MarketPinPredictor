# Polygon/Massive API Configuration
# Copy this file to .env and fill in your real values.

# Primary API Key - Live Streaming & Real-time Data (REST/WebSocket)
DATABENTO_API_KEY=YOUR_DATABENTO_API_KEY
DATABENTO_SYMBOLS=SPX,NDX,VIX
DATABENTO_REQUIRED_SYMBOLS=SPX,NDX
# Canary candidates supported by the adapter: XSP,XND,RUT,MRUT,OEX,DJX,RUI,XAU,HGX,OSX,UTY
# Add only one canary at a time after validating contract coverage and quote freshness.
# RUT canary monitoring never adds RUT implicitly; RUT must also be explicitly
# present in DATABENTO_SYMBOLS. Freshness and lag budgets are fixed in code.
DATABENTO_RUT_CANARY_ENABLED=0

# Databento live-subscription safety. Strike selection is dynamic from current
# definitions/OI; these limits count complete same-strike call/put pairs.
DATABENTO_SUBSCRIPTION_PROFILE=near-term-shadow
DATABENTO_PRIMARY_MAX_STRIKE_PAIRS=600
DATABENTO_SHADOW_MAX_STRIKE_PAIRS=200
DATABENTO_MIN_PRIMARY_STRIKE_PAIRS=100
DATABENTO_MIN_CORE_PRIMARY_PAIR_COMPLETENESS_RATIO=0.90
# Fixed runtime safety budgets: primary pair coverage 0.10; fresh/expected quote coverage 0.50.
DATABENTO_MIN_NEXT_LISTED_STRIKE_PAIRS=50
DATABENTO_MAX_CONTRACTS_PER_MARKET=1800
DATABENTO_MAX_SUBSCRIPTION_CONTRACTS=3600
DATABENTO_CENTER_PAIR_FRACTION=0.60
# A prior cache is only an explicitly labelled contract scaffold. Live quotes
# from the active subscription generation are still required for every result.
DATABENTO_ALLOW_PRIOR_UNIVERSE_FALLBACK=1
# Prevent closed/pre-open inactivity and scheduled universe age from churning
# the live socket. Current-day metadata can be staged atomically out of band.
DATABENTO_OPEN_TRANSITION_GRACE_SECONDS=90
DATABENTO_ALLOW_LIVE_UNIVERSE_REFRESH_RECONNECT=0
# Replay is useful only for pre-open/closed-session initial warm-up. Enabling
# either live-session option can create a large stale-record burst and is opt-in.
DATABENTO_REPLAY_MINUTES=2
DATABENTO_REPLAY_ON_RECONNECT=0
DATABENTO_REPLAY_DURING_REGULAR_SESSION=0
DATABENTO_COMPUTE_WARMUP_GRACE_SECONDS=30
DATABENTO_OVERLOAD_COMPUTE_BACKOFF_SECONDS=30
MASSIVE_API_KEY=YOUR_MASSIVE_API_KEY  # legacy fallback
Massive_API=YOUR_MASSIVE_API_KEY  # legacy fallback
POLYGON_API_KEY=YOUR_POLYGON_API_KEY  # legacy fallback
POLYGON_STREAMING_KEY=YOUR_POLYGON_API_KEY  # legacy fallback

# Secondary API Key - Historical Flat Files & Bulk Downloads
POLYGON_HISTORICAL_KEY=YOUR_POLYGON_HISTORICAL_KEY
POLYGON_FLATFILES_KEY=YOUR_POLYGON_FLATFILES_KEY

# MASSIVE S3 Credentials (for bulk historical downloads)
MASSIVE_S3_ACCESS_KEY_ID=YOUR_MASSIVE_ACCESS_KEY_ID
MASSIVE_S3_SECRET_ACCESS_KEY=YOUR_MASSIVE_SECRET_ACCESS_KEY
MASSIVE_ACCESS_KEY_ID=YOUR_MASSIVE_ACCESS_KEY_ID  # legacy fallback
MASSIVE_SECRET_ACCESS_KEY=YOUR_MASSIVE_SECRET_ACCESS_KEY  # legacy fallback
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles

# Optional: Force CPU mode (set to true if GPU has issues)
FORCE_CPU=false

# Canonical live-metrics database. Startup scripts resolve this to an absolute path.
DATABASE_URL=sqlite:///./data/market_data.db

# Local, read-only prediction-governance API. Set a unique secret of at least
# 16 characters before using /v1/workstation/passports endpoints, then send it
# in the X-MarketPin-Governance-Token header. Keep remote access disabled unless
# a separate trusted network boundary and shared rate limiter are in place.
MARKETPIN_GOVERNANCE_ACCESS_TOKEN=
MARKETPIN_GOVERNANCE_ALLOW_REMOTE=0
MARKETPIN_ANALYST_REQUESTS_PER_MINUTE=10
OPENAI_API_KEY=
MARKETPIN_ANALYST_MODEL=gpt-5.4-mini
MARKETPIN_ANALYST_REASONING_EFFORT=medium

# Data Sampling Configuration (PREMIUM TIER - Maximum Real-time)
UPDATE_INTERVAL=10
ENABLE_0DTE=true
OPTIONS_EXPIRY_DAYS=45
OPTIONS_MAX_CONTRACTS=7500
USE_MINUTE_BARS=true
AGGREGATE_TIMESPAN=1
AGGREGATE_LOOKBACK=120
ENABLE_WEBSOCKET_STREAMING=true

# Training configuration
BATCH_SIZE=2048
ENABLE_GPU_TRAINING=true
MODEL_ARCHITECTURE=deep
