# Backup .env template (no secrets)
POLYGON_STREAMING_KEY=your_streaming_key_here
POLYGON_HISTORICAL_KEY=your_flatfiles_key_here
MASSIVE_ACCESS_KEY_ID=your_flatfiles_access_key_id
MASSIVE_SECRET_ACCESS_KEY=your_flatfiles_secret_access_key
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles
LIVE_MARKET_CACHE_TTL=2
LIVE_GAMMA_CACHE_TTL=60
LIVE_AGENT_VERBOSE=false
LIVE_NDJSON_ENABLED=true
LIVE_NDJSON_DIR=exports/live_ticks
LIVE_NDJSON_FLUSH_INTERVAL=5
LIVE_NDJSON_MAX_BATCH=500
